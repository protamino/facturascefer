<Window x:Class="FacturasCefer.Dialogs.ProveedorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proveedor" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="TxtAviso" Visibility="Collapsed" TextWrapping="Wrap" Padding="10,6" Margin="0,0,0,8"
                   Background="#FFF4E5" Foreground="#8A5300"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                <TextBlock Text="Razón social *" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtRazonSocial" MaxLength="200"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0">
                <TextBlock Text="CIF / NIF *" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtCif" MaxLength="20" CharacterCasing="Upper"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2">
                <TextBlock Text="Forma de pago *" Style="{StaticResource Etiqueta}"/>
                <ComboBox x:Name="CmbFormaPago" SelectionChanged="CmbFormaPago_SelectionChanged" Height="26"
                          VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Transferencia (CEFER paga al IBAN del proveedor)"/>
                    <ComboBoxItem Content="Domiciliación (el proveedor gira recibo a CEFER)"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0">
                <TextBlock Text="Dirección" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtDireccion" MaxLength="250"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2">
                <TextBlock x:Name="LblIban" Text="IBAN del proveedor" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtIban" MaxLength="42" CharacterCasing="Upper" FontFamily="Consolas"/>
            </StackPanel>

            <Grid Grid.Row="3" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="CP" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtCp" MaxLength="10"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Población" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtPoblacion" MaxLength="100"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Provincia" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtProvincia" MaxLength="100"/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="País" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtPais" MaxLength="60"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="4" Grid.Column="0">
                <TextBlock Text="Email" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtEmail" MaxLength="150"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="2">
                <TextBlock Text="Teléfono" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtTelefono" MaxLength="30"/>
            </StackPanel>

            <StackPanel Grid.Row="5" Grid.ColumnSpan="3">
                <TextBlock Text="Observaciones" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtObservaciones" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="TxtError" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnGuardar" Content="Guardar" IsDefault="True" Margin="0,0,8,0" MinWidth="90"
                    Click="BtnGuardar_Click"/>
            <Button Content="Cancelar" IsCancel="True" MinWidth="90"/>
        </StackPanel>
    </StackPanel>
</Window>
