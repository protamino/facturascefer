<Window x:Class="FacturasCefer.Dialogs.CuentaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cuenta contable" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="Código (8 dígitos) *" Style="{StaticResource Etiqueta}"/>
        <TextBox x:Name="TxtCodigo" MaxLength="8" Width="120" HorizontalAlignment="Left" FontFamily="Consolas"/>
        <TextBlock Text="Descripción *" Style="{StaticResource Etiqueta}"/>
        <TextBox x:Name="TxtDescripcion" MaxLength="150"/>

        <TextBlock x:Name="TxtError" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnGuardar" Content="Guardar" IsDefault="True" MinWidth="90" Margin="0,0,8,0" Click="BtnGuardar_Click"/>
            <Button Content="Cancelar" IsCancel="True" MinWidth="90"/>
        </StackPanel>
    </StackPanel>
</Window>
