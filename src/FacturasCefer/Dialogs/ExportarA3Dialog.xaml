<Window x:Class="FacturasCefer.Dialogs.ExportarA3Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar facturas recibidas — a3ASESOR | con" Width="1150" Height="720" MinWidth="900" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Der" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style x:Key="FilaA3" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Nivel}" Value="Error">
                    <Setter Property="Foreground" Value="#B71C1C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Nivel}" Value="Aviso">
                    <Setter Property="Foreground" Value="#8A5300"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Filtros -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Fecha de factura desde" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker x:Name="DpDesde" Width="115"/>
            <TextBlock Text="hasta" VerticalAlignment="Center" Margin="8,0,6,0"/>
            <DatePicker x:Name="DpHasta" Width="115"/>
            <TextBlock Text="Estados:" VerticalAlignment="Center" Margin="18,0,6,0"/>
            <CheckBox x:Name="ChkValidada" Content="Validada" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <CheckBox x:Name="ChkPagada" Content="Pagada" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <CheckBox x:Name="ChkRecibida" Content="Recibida" VerticalAlignment="Center" Margin="0,0,18,0"/>
            <CheckBox x:Name="ChkExportadas" Content="Incluir ya exportadas" VerticalAlignment="Center" Margin="0,0,18,0"/>
            <Button Content="Buscar" MinWidth="90" Click="BtnBuscar_Click"/>
        </WrapPanel>

        <TextBlock x:Name="TxtConfig" DockPanel.Dock="Top" Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>

        <!-- Pie: destino y exportar -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock Text="Archivo:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button DockPanel.Dock="Right" Content="…" Width="32" Margin="6,0,0,0" Click="BtnRuta_Click"/>
                <TextBox x:Name="TxtRuta"/>
            </DockPanel>
            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Marcar todas las válidas" Click="BtnTodas_Click" Margin="0,0,6,0"/>
                <Button DockPanel.Dock="Left" Content="Desmarcar todas" Click="BtnNinguna_Click" Margin="0,0,6,0"/>
                <Button DockPanel.Dock="Left" Content="Copiar incidencias" Click="BtnCopiar_Click"/>
                <Button DockPanel.Dock="Right" Content="Cerrar" IsCancel="True" MinWidth="90"/>
                <Button x:Name="BtnExportar" DockPanel.Dock="Right" Content="Exportar CSV" FontWeight="Bold" MinWidth="120"
                        Margin="0,0,8,0" Click="BtnExportar_Click"/>
            </DockPanel>
        </StackPanel>

        <TextBlock x:Name="TxtResumen" DockPanel.Dock="Bottom" Margin="0,6,0,0" Foreground="#444"/>

        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E5E5" SelectionMode="Extended"
                  RowStyle="{StaticResource FilaA3}" RowHeight="24">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Exp." Width="42">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Seleccionada, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding Exportable}" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="" Binding="{Binding Icono}" Width="26" IsReadOnly="True"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Nº factura" Binding="{Binding Numero}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="85" IsReadOnly="True"
                                    ElementStyle="{StaticResource Der}"/>
                <DataGridTextColumn Header="Filas" Binding="{Binding Filas}" Width="45" IsReadOnly="True"/>
                <DataGridTextColumn Header="Exportada" Binding="{Binding Exportada, StringFormat=dd/MM/yyyy}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Incidencias" Binding="{Binding TextoIncidencias}" Width="2*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding TextoIncidenciasCompleto}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
