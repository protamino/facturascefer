<Window x:Class="FacturasCefer.Dialogs.FacturaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Factura" Width="760" Height="720" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Importe" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Seccion" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,14,0,2"/>
            <Setter Property="Foreground" Value="#1F4E79"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <!-- Cabecera -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TxtProveedor" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtEstado" Margin="0,2,0,0" TextWrapping="Wrap"/>
            <Border x:Name="PanelIban" Visibility="Collapsed" Background="#FDECEA" Padding="10,6" Margin="0,8,0,0" CornerRadius="3">
                <TextBlock x:Name="TxtIbanAviso" Foreground="#8B1A1A" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Botones -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Abrir PDF" Click="BtnPdf_Click" Margin="0,0,8,0"/>
            <Button x:Name="BtnOriginal" DockPanel.Dock="Left" Content="Abrir PDF original" Click="BtnOriginal_Click"/>
            <Button DockPanel.Dock="Right" Content="Cerrar" IsCancel="True" MinWidth="90"/>
            <Button x:Name="BtnGuardar" DockPanel.Dock="Right" Content="Guardar cambios" FontWeight="Bold" Margin="0,0,8,0"
                    Click="BtnGuardar_Click"/>
        </DockPanel>

        <TextBlock x:Name="TxtError" DockPanel.Dock="Bottom" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="120"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="Formulario" Grid.Row="0">
                <TextBlock Text="Factura" Style="{StaticResource Seccion}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nº factura *" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtNumero" MaxLength="50"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Fecha *" Style="{StaticResource Etiqueta}"/>
                        <DatePicker x:Name="DpFecha"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Vencimiento" Style="{StaticResource Etiqueta}"/>
                        <DatePicker x:Name="DpVencimiento"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Forma de pago" Style="{StaticResource Etiqueta}"/>
                        <ComboBox x:Name="CmbFormaPago" Height="26" VerticalContentAlignment="Center"
                                  SelectionChanged="CmbFormaPago_SelectionChanged">
                            <ComboBoxItem Content="Transferencia"/>
                            <ComboBoxItem Content="Domiciliación"/>
                            <ComboBoxItem Content="Tarjeta"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="PanelIbanFac">
                    <TextBlock x:Name="LblIban" Text="IBAN del proveedor" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtIban" CharacterCasing="Upper" MaxLength="42" FontFamily="Consolas"/>
                </StackPanel>
                <StackPanel x:Name="PanelTarjetaFac" Visibility="Collapsed">
                    <TextBlock Text="Tarjeta con la que se pagó" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtTarjeta" MaxLength="60"/>
                </StackPanel>
                <TextBlock Text="Concepto" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtConcepto" MaxLength="500"/>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Base" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtBase" Style="{StaticResource Importe}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="% IVA" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtPorcIva" Style="{StaticResource Importe}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="IVA" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtCuotaIva" Style="{StaticResource Importe}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="% IRPF" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtPorcIrpf" Style="{StaticResource Importe}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="8">
                        <TextBlock Text="IRPF" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtCuotaIrpf" Style="{StaticResource Importe}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="10">
                        <TextBlock Text="Total *" Style="{StaticResource Etiqueta}" FontWeight="Bold"/>
                        <TextBox x:Name="TxtTotal" Style="{StaticResource Importe}" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Observaciones" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtObservaciones" Height="50" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalContentAlignment="Top"/>
            </StackPanel>

            <DockPanel Grid.Row="1">
                <TextBlock DockPanel.Dock="Top" Text="Historial de estados" Style="{StaticResource Seccion}"/>
                <DataGrid x:Name="GridHistorial" Style="{StaticResource Tabla}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="120"/>
                        <DataGridTextColumn Header="Cambio" Binding="{Binding Cambio}" Width="180"/>
                        <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="100"/>
                        <DataGridTextColumn Header="Comentario" Binding="{Binding Comentario}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
