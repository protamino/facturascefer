<Window x:Class="FacturasCefer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FacturasCefer.Views"
        Title="FacturasCefer" Height="820" Width="1360" MinHeight="580" MinWidth="1040"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing"
        Background="{StaticResource Fondo}" Foreground="{StaticResource Texto}">
    <Window.Resources>
        <!-- Icono (Segoe MDL2 Assets) + texto de cada sección de la barra lateral -->
        <Style x:Key="Icono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Barra lateral -->
        <Border Background="{StaticResource LateralFondo}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,18">
                    <Image Source="pack://application:,,,/FacturasCefer;component/Assets/logo-cefer-on-dark.png" Height="32" HorizontalAlignment="Left" Margin="0,0,0,12"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Facturas de proveedores" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="Registro, control y pago" Foreground="{StaticResource LateralTexto}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LateralLinea}" BorderThickness="0,1,0,0" Padding="20,14">
                    <StackPanel>
                        <TextBlock x:Name="TxtUsuario" Foreground="White" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtVersion" Foreground="{StaticResource LateralTexto}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{StaticResource LateralLinea}" BorderThickness="0,1,0,0" Padding="12,14">
                    <StackPanel>
                        <RadioButton x:Name="NavInicio" Style="{StaticResource ItemLateral}" GroupName="Nav" Checked="Nav_Checked" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icono}" Text="&#xE80F;"/>
                                <TextBlock Text="Inicio"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSubir" Style="{StaticResource ItemLateral}" GroupName="Nav" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icono}" Text="&#xE898;"/>
                                <TextBlock Text="Subir facturas"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavFacturas" Style="{StaticResource ItemLateral}" GroupName="Nav" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icono}" Text="&#xE8A5;"/>
                                <TextBlock Text="Facturas"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavProveedores" Style="{StaticResource ItemLateral}" GroupName="Nav" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icono}" Text="&#xE716;"/>
                                <TextBlock Text="Proveedores"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavCuentas" Style="{StaticResource ItemLateral}" GroupName="Nav" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icono}" Text="&#xE8EF;"/>
                                <TextBlock Text="Cuentas contables"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavImportaciones" Style="{StaticResource ItemLateral}" GroupName="Nav" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icono}" Text="&#xE715;"/>
                                <TextBlock Text="Importaciones (correo)"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ============ Contenido -->
        <DockPanel Grid.Column="1" Margin="28,22,28,20">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock x:Name="TxtTitulo" Style="{StaticResource TituloPagina}"/>
                <TextBlock x:Name="TxtSubtitulo" Style="{StaticResource SubtituloPagina}"/>
            </StackPanel>
            <Grid>
                <views:InicioView x:Name="Inicio" Ir="Inicio_Ir"/>
                <views:SubirFacturasView x:Name="Subir" Visibility="Collapsed"/>
                <views:FacturasView x:Name="Facturas" Visibility="Collapsed"/>
                <views:ProveedoresView x:Name="Proveedores" Visibility="Collapsed" VerFacturas="Proveedores_VerFacturas"/>
                <views:CuentasView x:Name="Cuentas" Visibility="Collapsed"/>
                <views:ImportacionesView x:Name="Importaciones" Visibility="Collapsed" IrASubir="Importaciones_IrASubir"/>
            </Grid>
        </DockPanel>

        <!-- ============ Avisos no bloqueantes (abajo a la derecha) -->
        <StackPanel x:Name="PanelAvisos" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,24,20" Panel.ZIndex="100"/>
    </Grid>
</Window>
