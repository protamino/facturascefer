<Window x:Class="FacturasCefer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FacturasCefer.Views"
        Title="FacturasCefer" Height="800" Width="1300" MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F4F6F8" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <TextBlock x:Name="TxtUsuario" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#555"/>
                <TextBlock Text="FacturasCefer" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="8" Padding="8">
            <TabItem Header="Subir facturas">
                <views:SubirFacturasView x:Name="Subir"/>
            </TabItem>
            <TabItem x:Name="TabFacturas" Header="Facturas">
                <views:FacturasView x:Name="Facturas"/>
            </TabItem>
            <TabItem Header="Proveedores">
                <views:ProveedoresView x:Name="Proveedores" VerFacturas="Proveedores_VerFacturas"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
