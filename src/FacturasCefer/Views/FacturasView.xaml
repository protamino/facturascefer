<UserControl x:Class="FacturasCefer.Views.FacturasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:FacturasCefer.Controls">
    <UserControl.Resources>
        <Style x:Key="Fila" TargetType="DataGridRow" BasedOn="{StaticResource FilaTabla}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding VencePronto}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AvisoTexto}"/>
                    <Setter Property="ToolTip" Value="Vence en los próximos 7 días"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Vencida}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ErrorTexto}"/>
                    <Setter Property="ToolTip" Value="Vencida y sin pagar"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Anulada}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextoTenue}"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Filtro" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="14,0,6,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextoEtiqueta}"/>
        </Style>
        <!-- Separación vertical entre filas de filtros cuando la barra se parte en varias líneas -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,4,8,4"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Filtros -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Tarjeta}" Padding="12,8" Margin="0,0,0,10">
        <WrapPanel>
            <TextBlock Text="Estado:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextoEtiqueta}"/>
            <CheckBox x:Name="ChkRecibida" Content="Recibida" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0"
                      Checked="Filtro_Changed" Unchecked="Filtro_Changed"/>
            <CheckBox x:Name="ChkValidada" Content="Validada" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0"
                      Checked="Filtro_Changed" Unchecked="Filtro_Changed"/>
            <CheckBox x:Name="ChkPagada" Content="Pagada" VerticalAlignment="Center" Margin="0,0,8,0"
                      Checked="Filtro_Changed" Unchecked="Filtro_Changed"/>
            <CheckBox x:Name="ChkRechazada" Content="Rechazada/Anulada" VerticalAlignment="Center"
                      Checked="Filtro_Changed" Unchecked="Filtro_Changed"/>

            <TextBlock Text="Proveedor:" Style="{StaticResource Filtro}"/>
            <ComboBox x:Name="CmbProveedor" Width="230" IsEditable="True" IsTextSearchEnabled="True"
                      SelectionChanged="Filtro_Changed" VerticalContentAlignment="Center"/>

            <TextBlock Text="Pago:" Style="{StaticResource Filtro}"/>
            <ComboBox x:Name="CmbFormaPago" Width="120" SelectedIndex="0" SelectionChanged="Filtro_Changed"
                      VerticalContentAlignment="Center">
                <ComboBoxItem Content="(Todas)"/>
                <ComboBoxItem Content="Transferencia"/>
                <ComboBoxItem Content="Domiciliación"/>
                <ComboBoxItem Content="Tarjeta"/>
            </ComboBox>

            <TextBlock Text="Vencimiento:" Style="{StaticResource Filtro}"/>
            <ComboBox x:Name="CmbVencimiento" Width="170" SelectedIndex="0" SelectionChanged="Filtro_Changed"
                      ToolTip="Solo facturas pendientes de pago (recibidas o validadas)">
                <ComboBoxItem Content="(Todos)"/>
                <ComboBoxItem Content="Vencidas"/>
                <ComboBoxItem Content="Vencen en ≤ 7 días"/>
                <ComboBoxItem Content="Vencidas o en ≤ 7 días"/>
            </ComboBox>

            <TextBlock Text="Origen:" Style="{StaticResource Filtro}"/>
            <ComboBox x:Name="CmbOrigen" Width="90" SelectedIndex="0" SelectionChanged="Filtro_Changed"
                      VerticalContentAlignment="Center">
                <ComboBoxItem Content="(Todos)"/>
                <ComboBoxItem Content="Manual"/>
                <ComboBoxItem Content="Correo"/>
            </ComboBox>
            <CheckBox x:Name="ChkRevisar" Content="⚑ Solo por revisar" VerticalAlignment="Center" Margin="10,0,0,0"
                      ToolTip="Facturas importadas automáticamente que alguien tiene que revisar"
                      Checked="Filtro_Changed" Unchecked="Filtro_Changed"/>

            <TextBlock Text="Cuenta:" Style="{StaticResource Filtro}"/>
            <ComboBox x:Name="CmbCuenta" Width="200" IsEditable="True" IsTextSearchEnabled="True"
                      SelectionChanged="Filtro_Changed" VerticalContentAlignment="Center"/>

            <ComboBox x:Name="CmbCampoFecha" Width="120" Margin="14,0,6,0" SelectedIndex="0"
                      SelectionChanged="Filtro_Changed" VerticalContentAlignment="Center">
                <ComboBoxItem Content="Fecha factura"/>
                <ComboBoxItem Content="Vencimiento"/>
            </ComboBox>
            <TextBlock Text="desde" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <DatePicker x:Name="DpDesde" Width="115" SelectedDateChanged="Filtro_Changed"/>
            <TextBlock Text="hasta" VerticalAlignment="Center" Margin="6,0,4,0"/>
            <DatePicker x:Name="DpHasta" Width="115" SelectedDateChanged="Filtro_Changed"/>

            <TextBlock Text="Buscar:" Style="{StaticResource Filtro}"/>
            <TextBox x:Name="TxtBuscar" Width="180" TextChanged="TxtBuscar_TextChanged"
                     ToolTip="Nº de factura, concepto, proveedor o CIF"/>
            <Button Content="Limpiar filtros" Margin="10,4,0,4" Click="BtnLimpiar_Click"/>
        </WrapPanel>
        </Border>

        <!-- Acciones -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <WrapPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource BotonBarra}">
                    <Setter Property="Margin" Value="0,0,6,6"/>
                </Style>
            </WrapPanel.Resources>
            <Button x:Name="BtnValidar" Content="✔ Validar" Style="{StaticResource BotonBarraPrimario}" Margin="0,0,6,6" Click="BtnValidar_Click"/>
            <Button x:Name="BtnPagar" Content="€ Marcar pagada…" Click="BtnPagar_Click"/>
            <Button x:Name="BtnRechazar" Content="✖ Rechazar / anular…" Style="{StaticResource BotonPeligro}" Margin="0,0,6,6" Click="BtnRechazar_Click"/>
            <Button x:Name="BtnDeshacer" Content="↶ Deshacer último cambio" Click="BtnDeshacer_Click"/>
            <Separator Width="16" Background="Transparent"/>
            <Button x:Name="BtnCuenta" Content="Asignar cuenta…" Click="BtnCuenta_Click"/>
            <Button x:Name="BtnFicha" Content="Ficha…" Click="BtnFicha_Click"/>
            <Button x:Name="BtnPdf" Content="Abrir PDF" Click="BtnPdf_Click"/>
            <Button Content="Actualizar" Click="BtnActualizar_Click"/>
            <Separator Width="16" Background="Transparent"/>
            <Button Content="⤓ Excel…" Click="BtnExcel_Click" ToolTip="Exportar el listado actual (con estos filtros) a Excel"/>
            <Button Content="⇪ Exportaciones ▸ a3ASESOR | con…" Click="BtnExportarA3_Click"
                    ToolTip="Exportar facturas recibidas a CSV para el Importador de Datos de a3ASESOR | con"/>
        </WrapPanel>

        <!-- Pie -->
        <TextBlock x:Name="TxtResumen" DockPanel.Dock="Bottom" Foreground="{StaticResource TextoSuave}" Margin="0,8,0,0"/>

        <Grid>
        <DataGrid x:Name="Grid" Style="{StaticResource Tabla}" SelectionMode="Extended" RowStyle="{StaticResource Fila}"
                  CanUserSortColumns="True" MouseDoubleClick="Grid_MouseDoubleClick" SelectionChanged="Grid_SelectionChanged">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="MnuValidar" Header="Validar" Click="BtnValidar_Click"/>
                    <MenuItem x:Name="MnuPagar" Header="Marcar pagada…" Click="BtnPagar_Click"/>
                    <MenuItem x:Name="MnuRechazar" Header="Rechazar / anular…" Click="BtnRechazar_Click"/>
                    <MenuItem x:Name="MnuDeshacer" Header="Deshacer último cambio" Click="BtnDeshacer_Click"/>
                    <Separator/>
                    <MenuItem x:Name="MnuFicha" Header="Ficha…" Click="BtnFicha_Click"/>
                    <MenuItem x:Name="MnuPdf" Header="Abrir PDF" Click="BtnPdf_Click"/>
                    <Separator/>
                    <MenuItem x:Name="MnuCuenta" Header="Asignar cuenta…" Click="BtnCuenta_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="⚑" Binding="{Binding AvisoRevision}" Width="32" MinWidth="32">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource Celda}">
                            <Setter Property="ToolTip" Value="{Binding MotivoRevision}"/>
                            <Setter Property="Foreground" Value="{StaticResource Marca}"/>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="2*" MinWidth="180"/>
                <DataGridTextColumn Header="Nº factura" Binding="{Binding NumeroFactura}" Width="120" MinWidth="120"/>
                <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="2*" MinWidth="140"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaFactura, StringFormat=dd/MM/yyyy}" Width="90" MinWidth="90"/>
                <DataGridTextColumn Header="Vencimiento" Binding="{Binding FechaVencimiento, StringFormat=dd/MM/yyyy}" Width="95" MinWidth="95"/>
                <DataGridTextColumn Header="Días" Binding="{Binding DiasVencimiento}" Width="75" MinWidth="75"
                                    SortMemberPath="FechaVencimiento"/>
                <DataGridTextColumn Header="Base" Binding="{Binding BaseImponible, StringFormat=N2}" Width="85" MinWidth="85"
                                    ElementStyle="{StaticResource Derecha}"/>
                <DataGridTextColumn Header="IVA" Binding="{Binding CuotaIVA, StringFormat=N2}" Width="75" MinWidth="75"
                                    ElementStyle="{StaticResource Derecha}"/>
                <DataGridTextColumn Header="IRPF" Binding="{Binding CuotaIRPF, StringFormat=N2}" Width="70" MinWidth="70"
                                    ElementStyle="{StaticResource Derecha}"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="90" MinWidth="90" FontWeight="Bold"
                                    ElementStyle="{StaticResource Derecha}"/>
                <DataGridTextColumn Header="Pago" Binding="{Binding FormaPagoCorta}" Width="70" MinWidth="70"/>
                <DataGridTextColumn Header="Cuenta" Binding="{Binding CuentaTexto}" Width="150" MinWidth="150"/>
                <DataGridTemplateColumn Header="Estado" Width="125" MinWidth="125" SortMemberPath="EstadoTexto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PastillaEstado}">
                                <TextBlock Text="{Binding EstadoTexto}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Origen" Binding="{Binding OrigenTexto}" Width="70" MinWidth="70"/>
                <DataGridTextColumn Header="Pagada el" Binding="{Binding FechaPago, StringFormat=dd/MM/yyyy}" Width="90" MinWidth="90"/>
                <DataGridTextColumn Header="IBAN" Binding="{Binding AvisoIban}" Width="45" MinWidth="45">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource Celda}">
                            <Setter Property="ToolTip" Value="El IBAN de la factura no coincide con el del proveedor"/>
                            <Setter Property="Foreground" Value="{StaticResource ErrorTexto}"/>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <ctrl:EstadoLista x:Name="Estado" MensajeVacio="No hay facturas con estos filtros.&#x0a;Prueba a marcar más estados o a ampliar las fechas."/>
        </Grid>
    </DockPanel>
</UserControl>
