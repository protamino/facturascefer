<UserControl x:Class="FacturasCefer.Views.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:FacturasCefer.Controls">
    <DockPanel>
        <!-- Acciones -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <WrapPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource BotonBarra}">
                    <Setter Property="Margin" Value="0,0,6,6"/>
                </Style>
            </WrapPanel.Resources>
            <Button Content="+ Nuevo proveedor" Style="{StaticResource BotonPrimario}" Margin="0,0,6,6" Click="BtnNuevo_Click"/>
            <Button x:Name="BtnEditar" Content="Editar…" Click="BtnEditar_Click"/>
            <Button x:Name="BtnBaja" Content="Dar de baja" Click="BtnBaja_Click"/>
            <Button x:Name="BtnHistIban" Content="Historial IBAN" Click="BtnHistIban_Click"/>
            <Button x:Name="BtnFacturas" Content="Ver facturas" Click="BtnFacturas_Click"/>
            <Button Content="Actualizar" Click="BtnActualizar_Click"/>
        </WrapPanel>

        <!-- Filtros -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Tarjeta}" Padding="12,8" Margin="0,0,0,10">
            <WrapPanel>
                <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextoEtiqueta}"/>
                <TextBox x:Name="TxtBuscar" Width="260" Margin="0,4,16,4"
                         TextChanged="TxtBuscar_TextChanged" ToolTip="Razón social o CIF"/>
                <TextBlock Text="Cuentas:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextoEtiqueta}"/>
                <ComboBox x:Name="CmbCuentas" Width="210" SelectedIndex="0" Margin="0,4,16,4"
                          SelectionChanged="Filtro_Changed">
                    <ComboBoxItem Content="(Todos)"/>
                    <ComboBoxItem Content="Sin cuenta de gasto"/>
                    <ComboBoxItem Content="Sin cuenta de proveedor (400…)"/>
                    <ComboBoxItem Content="Sin ninguna de las dos"/>
                    <ComboBoxItem Content="Sin alguna de las dos"/>
                </ComboBox>
                <CheckBox x:Name="ChkPendientes" Content="⚑ Solo altas automáticas por revisar" Margin="0,4,16,4"
                          ToolTip="Proveedores dados de alta por el importador de correo; se quita la marca al guardar su ficha"
                          Checked="Filtro_Changed" Unchecked="Filtro_Changed"/>
                <CheckBox x:Name="ChkBajas" Content="Mostrar bajas" Margin="0,4,0,4"
                          Checked="Filtro_Changed" Unchecked="Filtro_Changed"/>
            </WrapPanel>
        </Border>

        <TextBlock x:Name="TxtContador" DockPanel.Dock="Bottom" Foreground="{StaticResource TextoSuave}" Margin="0,8,0,0"/>

        <Grid>
        <DataGrid x:Name="Grid" Style="{StaticResource Tabla}" RowStyle="{StaticResource FilaConBaja}"
                  MouseDoubleClick="Grid_MouseDoubleClick" SelectionChanged="Grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="⚑" Binding="{Binding AvisoRevision}" Width="28" MinWidth="28">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource Celda}">
                            <Setter Property="ToolTip" Value="Alta automática desde el correo: revisar y guardar la ficha"/>
                            <Setter Property="Foreground" Value="{StaticResource Marca}"/>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Razón social" Binding="{Binding RazonSocial}" Width="2*" MinWidth="200"/>
                <DataGridTextColumn Header="CIF" Binding="{Binding CIF}" Width="110" MinWidth="110"/>
                <DataGridTextColumn Header="Forma de pago" Binding="{Binding FormaPagoTexto}" Width="110" MinWidth="110"/>
                <DataGridTextColumn Header="Cta. gasto" Binding="{Binding CuentaContable}" Width="85" MinWidth="85"/>
                <DataGridTextColumn Header="Cta. proveedor" Binding="{Binding CuentaProveedor}" Width="95" MinWidth="95"/>
                <DataGridTextColumn Header="IBAN" Binding="{Binding IbanFormateado}" Width="250" MinWidth="250"/>
                <DataGridTextColumn Header="Población" Binding="{Binding Poblacion}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="110" MinWidth="110"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" MinWidth="150"/>
            </DataGrid.Columns>
        </DataGrid>
        <ctrl:EstadoLista x:Name="Estado" MensajeVacio="No hay proveedores con estos filtros."/>
        </Grid>
    </DockPanel>
</UserControl>
