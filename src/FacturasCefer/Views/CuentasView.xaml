<UserControl x:Class="FacturasCefer.Views.CuentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:FacturasCefer.Controls">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox x:Name="ChkBajas" Content="Mostrar bajas" VerticalAlignment="Center" Margin="0,0,12,0"
                          Checked="Filtro_Changed" Unchecked="Filtro_Changed"/>
                <Button Content="+ Nueva cuenta" Style="{StaticResource BotonBarraPrimario}" Click="BtnNueva_Click"/>
                <Button x:Name="BtnEditar" Content="Editar…" Style="{StaticResource BotonBarra}" Click="BtnEditar_Click"/>
                <Button x:Name="BtnBaja" Content="Dar de baja" Style="{StaticResource BotonBarra}" Click="BtnBaja_Click"/>
                <Button Content="Actualizar" Click="BtnActualizar_Click"/>
            </StackPanel>
            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextoEtiqueta}"/>
            <TextBox x:Name="TxtBuscar" MaxWidth="320" HorizontalAlignment="Left" MinWidth="220"
                     TextChanged="TxtBuscar_TextChanged" ToolTip="Código o descripción"/>
        </DockPanel>

        <TextBlock x:Name="TxtContador" DockPanel.Dock="Bottom" Foreground="{StaticResource TextoSuave}" Margin="0,8,0,0"/>

        <Grid>
        <DataGrid x:Name="Grid" Style="{StaticResource Tabla}" RowStyle="{StaticResource FilaConBaja}"
                  MouseDoubleClick="Grid_MouseDoubleClick" SelectionChanged="Grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="100"/>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                <DataGridTextColumn Header="Proveedores" Binding="{Binding Proveedores}" Width="100"/>
                <DataGridTextColumn Header="Facturas" Binding="{Binding Facturas}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
        <ctrl:EstadoLista x:Name="Estado" MensajeVacio="No hay cuentas con estos filtros."/>
        </Grid>
    </DockPanel>
</UserControl>
