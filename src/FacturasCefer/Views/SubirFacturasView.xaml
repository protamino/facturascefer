<UserControl x:Class="FacturasCefer.Views.SubirFacturasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:ctrl="clr-namespace:FacturasCefer.Controls"
             AllowDrop="True" DragOver="Zona_DragOver" Drop="Zona_Drop" Focusable="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Caja de subida -->
        <Border x:Name="ZonaSubida" Grid.Row="0" BorderBrush="{StaticResource Rojo}" BorderThickness="2" CornerRadius="{StaticResource Radio}"
                Background="{StaticResource RojoTinteSuave}" Padding="16,12" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="+ Añadir PDF…" Click="BtnAnadir_Click" MinWidth="120"
                        Style="{StaticResource BotonPrimario}"/>
                <TextBlock DockPanel.Dock="Left" Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                           Foreground="{StaticResource Rojo}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="14" FontWeight="SemiBold"
                               Text="Arrastra aquí los PDF de las facturas, pégalos con Ctrl+V o pulsa «Añadir PDF…»"/>
                    <TextBlock x:Name="TxtCola" Foreground="{StaticResource TextoSuave}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Estado vacío -->
        <TextBlock x:Name="TxtVacio" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource TextoSuave}" FontSize="14" TextAlignment="Center"
                   Text="No hay facturas en revisión.&#x0a;Sube un PDF para empezar."/>

        <!-- Revisión -->
        <Grid x:Name="PanelRevision" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="480" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- Visor -->
            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Abrir en visor externo" Click="BtnAbrirExterno_Click"/>
                    <TextBlock x:Name="TxtNombrePdf" VerticalAlignment="Center" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <Border BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="{StaticResource Radio}"
                        Background="{StaticResource Superficie}" Padding="1">
                    <Grid>
                        <wv2:WebView2 x:Name="Visor"/>
                        <TextBlock x:Name="TxtVisorError" Visibility="Collapsed" TextWrapping="Wrap" Margin="16"
                                   Foreground="{StaticResource AvisoTexto}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Formulario -->
            <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Padding="16,12,8,12">
            <DockPanel>
                <!-- Barra de navegación entre facturas del PDF -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,8,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnAnterior" Content="◀" Click="BtnAnterior_Click" ToolTip="Factura anterior del PDF" Margin="0,0,4,0"/>
                        <Button x:Name="BtnSiguiente" Content="▶" Click="BtnSiguiente_Click" ToolTip="Factura siguiente del PDF"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="TxtPosicion" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtEstadoFactura" Foreground="{StaticResource TextoSuave}"/>
                    </StackPanel>
                </DockPanel>

                <!-- Resumen: estado de cada comprobación (pulsar para ir al campo) -->
                <WrapPanel x:Name="PanelResumen" DockPanel.Dock="Top" Margin="0,4,8,2" Visibility="Collapsed"/>

                <!-- Progreso IA -->
                <Border x:Name="PanelIA" DockPanel.Dock="Top" Visibility="Collapsed" Style="{StaticResource AvisoInfo}" Margin="0,4,8,4">
                    <DockPanel>
                        <Button x:Name="BtnCancelarIA" DockPanel.Dock="Right" Content="Cancelar" Click="BtnCancelarIA_Click"
                                VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="Dejar de leer este PDF y rellenar los datos a mano"/>
                        <StackPanel>
                            <TextBlock x:Name="TxtIA" Text="Leyendo la factura con IA…"/>
                            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Aviso general (errores IA, sin facturas…) -->
                <Border x:Name="PanelAviso" DockPanel.Dock="Top" Visibility="Collapsed" Style="{StaticResource AvisoAtencion}" Margin="0,4,8,4">
                    <DockPanel>
                        <Button x:Name="BtnReintentarIA" DockPanel.Dock="Right" Content="Reintentar IA" Click="BtnReintentarIA_Click"
                                VerticalAlignment="Top" Margin="8,0,0,0"/>
                        <TextBlock x:Name="TxtAviso" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>

                <!-- Botones -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,8,0" LastChildFill="False">
                    <Button x:Name="BtnDescartarPdf" DockPanel.Dock="Left" Content="Descartar PDF" Click="BtnDescartarPdf_Click"
                            Style="{StaticResource BotonPeligro}"
                            ToolTip="Descarta todas las facturas pendientes de este PDF"/>
                    <Button x:Name="BtnGuardar" DockPanel.Dock="Right" Content="Guardar factura" MinWidth="140"
                            Style="{StaticResource BotonPrimario}" Click="BtnGuardar_Click" ToolTip="Guardar esta factura (Ctrl+S)"/>
                    <Button x:Name="BtnDescartar" DockPanel.Dock="Right" Content="Descartar factura" Margin="0,0,8,0"
                            Click="BtnDescartar_Click"/>
                </DockPanel>

                <ScrollViewer x:Name="Formulario" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>
                        <Expander x:Name="SecProveedor" Header="Proveedor" Style="{StaticResource SeccionPlegable}" Margin="0,4,0,0">
                        <StackPanel>
                        <TextBlock Text="CIF / NIF del proveedor *" Style="{StaticResource Etiqueta}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Buscar" Click="BtnBuscarProveedor_Click" Margin="6,0,0,0"/>
                            <TextBox x:Name="TxtCif" CharacterCasing="Upper" MaxLength="20" LostFocus="TxtCif_LostFocus"/>
                        </DockPanel>
                        <Border x:Name="PanelProveedor" Style="{StaticResource AvisoAtencion}" Margin="0,6,0,0">
                            <DockPanel>
                                <Button x:Name="BtnAltaProveedor" DockPanel.Dock="Right" Content="Dar de alta…"
                                        Click="BtnAltaProveedor_Click" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock x:Name="TxtProveedor" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="Forma de pago" Style="{StaticResource Etiqueta}"/>
                        <ComboBox x:Name="CmbFormaPago"
                                  SelectionChanged="CmbFormaPago_SelectionChanged">
                            <ComboBoxItem Content="Transferencia"/>
                            <ComboBoxItem Content="Domiciliación (recibo a la cuenta de CEFER)"/>
                            <ComboBoxItem Content="Tarjeta (ya pagada)"/>
                        </ComboBox>
                        <TextBlock x:Name="TxtAvisoFormaPago" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{StaticResource AvisoTexto}"/>

                        <StackPanel x:Name="PanelIbanRev">
                            <TextBlock x:Name="LblIban" Text="IBAN del proveedor" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="TxtIban" CharacterCasing="Upper" MaxLength="42" FontFamily="Consolas"
                                     TextChanged="TxtIban_TextChanged"/>
                            <Border x:Name="PanelIban" Visibility="Collapsed" Style="{StaticResource AvisoInfo}" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtIbanAviso" TextWrapping="Wrap"/>
                                    <CheckBox x:Name="ChkActualizarIban" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Pago con tarjeta: se registra ya pagada -->
                        <Grid x:Name="PanelTarjeta" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tarjeta (marca y últimos 4 dígitos)" Style="{StaticResource Etiqueta}"/>
                                <ComboBox x:Name="CmbTarjeta" IsEditable="True"
                                          ToolTip="Ej.: VISA ···· 1234. Nunca se guarda el número completo."/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Fecha de pago *" Style="{StaticResource Etiqueta}"/>
                                <DatePicker x:Name="DpFechaPago"/>
                            </StackPanel>
                        </Grid>

                        <!-- Factura -->
                        </StackPanel>
                        </Expander>

                        <Expander x:Name="SecFactura" Header="Factura" Style="{StaticResource SeccionPlegable}">
                        <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nº factura *" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="TxtNumero" MaxLength="50"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Fecha *" Style="{StaticResource Etiqueta}"/>
                                <DatePicker x:Name="DpFecha"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Vencimiento" Style="{StaticResource Etiqueta}"/>
                                <DatePicker x:Name="DpVencimiento"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Concepto" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtConcepto" MaxLength="500"/>
                        <TextBlock Text="Cuenta contable (se puede asignar después)" Style="{StaticResource Etiqueta}"/>
                        <ctrl:CuentaSelector x:Name="SelCuenta" CodigoCambiado="SelCuenta_CodigoCambiado"/>
                        <CheckBox x:Name="ChkCuentaDefecto" Visibility="Collapsed" Margin="0,4,0,0" IsChecked="True"/>

                        <!-- Importes -->
                        </StackPanel>
                        </Expander>

                        <Expander x:Name="SecImportes" Header="Importes (€)" Style="{StaticResource SeccionPlegable}">
                        <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.ColumnSpan="5">
                                <TextBlock Text="Desglose de bases e IVA" Style="{StaticResource Etiqueta}"/>
                                <ctrl:DesgloseImpuestosGrid x:Name="Desglose" Cambiado="Desglose_Cambiado"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Retención IRPF" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="TxtCuotaIrpf" Style="{StaticResource Importe}" LostFocus="Importe_LostFocus"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="% IRPF" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="TxtPorcIrpf" Style="{StaticResource Importe}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="0">
                                <TextBlock Text="Total *" Style="{StaticResource Etiqueta}" FontWeight="Bold"/>
                                <TextBox x:Name="TxtTotal" Style="{StaticResource Importe}" FontWeight="Bold" LostFocus="Importe_LostFocus"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtCuadre" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="3" VerticalAlignment="Bottom"
                                       Margin="0,0,0,4" TextWrapping="Wrap"/>
                        </Grid>

                        </StackPanel>
                        </Expander>

                        <Expander x:Name="SecOtros" Header="Páginas y observaciones" Style="{StaticResource SeccionPlegable}">
                        <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Páginas del PDF: de" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtPagDesde" Width="45" TextAlignment="Center" LostFocus="Paginas_LostFocus"/>
                            <TextBlock Text="a" VerticalAlignment="Center" Margin="6,0"/>
                            <TextBox x:Name="TxtPagHasta" Width="45" TextAlignment="Center" LostFocus="Paginas_LostFocus"/>
                            <TextBlock x:Name="TxtTotalPaginas" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource TextoSuave}"/>
                        </StackPanel>
                        <TextBlock Text="Observaciones" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtObservaciones" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"/>

                        </StackPanel>
                        </Expander>

                        <TextBlock x:Name="TxtError" Style="{StaticResource TextoError}" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
