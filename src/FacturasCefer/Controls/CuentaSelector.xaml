<UserControl x:Class="FacturasCefer.Controls.CuentaSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Button DockPanel.Dock="Right" Content="…" Width="30" Margin="4,0,0,0" Click="BtnBuscar_Click"
                ToolTip="Buscar o dar de alta una cuenta"/>
        <ComboBox x:Name="Cmb" IsEditable="True" IsTextSearchEnabled="True" DisplayMemberPath="Texto"
                  TextSearch.TextPath="Texto" Height="26" VerticalContentAlignment="Center"
                  SelectionChanged="Cmb_SelectionChanged" LostFocus="Cmb_LostFocus"
                  ToolTip="Escribe el código o pulsa «…» para buscar por descripción"/>
    </DockPanel>
</UserControl>
