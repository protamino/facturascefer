<!--
    Tema visual de FacturasCefer: mismos colores y estilo que BANCOSEMEN
    (rojo CEFER, barra lateral granate oscura, fondo gris claro, tarjetas blancas con borde, tablas planas).
    Todos los colores de la app salen de aquí; desde C# usar la clase Tema.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================== Colores -->
    <Color x:Key="ColorRojo">#921F30</Color>
    <Color x:Key="ColorRojoOscuro">#7A1A28</Color>
    <Color x:Key="ColorRojoClaro">#B82840</Color>

    <SolidColorBrush x:Key="Rojo" Color="{StaticResource ColorRojo}"/>
    <SolidColorBrush x:Key="RojoOscuro" Color="{StaticResource ColorRojoOscuro}"/>
    <SolidColorBrush x:Key="RojoTinte" Color="#1A921F30"/>
    <SolidColorBrush x:Key="RojoTinteSuave" Color="#0D921F30"/>

    <SolidColorBrush x:Key="LateralFondo" Color="#1A0608"/>
    <SolidColorBrush x:Key="LateralTexto" Color="#C4A0A5"/>
    <SolidColorBrush x:Key="LateralHover" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="LateralLinea" Color="#1AFFFFFF"/>

    <SolidColorBrush x:Key="Fondo" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Superficie" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Borde" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BordeControl" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Separador" Color="#F1F5F9"/>

    <SolidColorBrush x:Key="Texto" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextoEtiqueta" Color="#334155"/>
    <SolidColorBrush x:Key="TextoSuave" Color="#64748B"/>
    <SolidColorBrush x:Key="TextoTenue" Color="#94A3B8"/>

    <SolidColorBrush x:Key="OkTexto" Color="#166534"/>
    <SolidColorBrush x:Key="OkFondo" Color="#F0FDF4"/>
    <SolidColorBrush x:Key="OkBorde" Color="#BBF7D0"/>
    <SolidColorBrush x:Key="ErrorTexto" Color="#B91C1C"/>
    <SolidColorBrush x:Key="ErrorFondo" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="ErrorBorde" Color="#FECACA"/>
    <SolidColorBrush x:Key="AvisoTexto" Color="#92400E"/>
    <SolidColorBrush x:Key="AvisoFondo" Color="#FFFBEB"/>
    <SolidColorBrush x:Key="AvisoBorde" Color="#FDE68A"/>
    <SolidColorBrush x:Key="InfoTexto" Color="#1E40AF"/>
    <SolidColorBrush x:Key="InfoFondo" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="InfoBorde" Color="#BFDBFE"/>
    <SolidColorBrush x:Key="NeutroTexto" Color="#475569"/>
    <SolidColorBrush x:Key="NeutroFondo" Color="#F1F5F9"/>
    <!-- ⚑ pendiente de revisar -->
    <SolidColorBrush x:Key="Marca" Color="#B45309"/>
    <!-- Campo marcado como dudoso por la IA -->
    <SolidColorBrush x:Key="DudosoFondo" Color="#FEF3C7"/>

    <CornerRadius x:Key="Radio">6</CornerRadius>

    <!-- ===================================================== Texto -->
    <Style x:Key="TituloPagina" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
    </Style>
    <Style x:Key="SubtituloPagina" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <Style x:Key="Seccion" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="Margin" Value="0,16,0,4"/>
    </Style>
    <Style x:Key="Etiqueta" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,8,0,3"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextoEtiqueta}"/>
    </Style>
    <Style x:Key="TextoSecundario" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="TextoError" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ErrorTexto}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- Celdas numéricas de las tablas -->
    <Style x:Key="Derecha" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===================================================== Contenedores -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Superficie}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radio}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="AvisoBase" TargetType="Border">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radio}"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style x:Key="AvisoError" TargetType="Border" BasedOn="{StaticResource AvisoBase}">
        <Setter Property="Background" Value="{StaticResource ErrorFondo}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ErrorBorde}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource ErrorTexto}"/>
    </Style>
    <Style x:Key="AvisoAtencion" TargetType="Border" BasedOn="{StaticResource AvisoBase}">
        <Setter Property="Background" Value="{StaticResource AvisoFondo}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AvisoBorde}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource AvisoTexto}"/>
    </Style>
    <Style x:Key="AvisoOk" TargetType="Border" BasedOn="{StaticResource AvisoBase}">
        <Setter Property="Background" Value="{StaticResource OkFondo}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OkBorde}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource OkTexto}"/>
    </Style>
    <Style x:Key="AvisoInfo" TargetType="Border" BasedOn="{StaticResource AvisoBase}">
        <Setter Property="Background" Value="{StaticResource InfoFondo}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InfoBorde}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource InfoTexto}"/>
    </Style>

    <!-- Pastilla de estado de la factura (Binding Estado) -->
    <Style x:Key="PastillaEstado" TargetType="Border">
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="8,1,8,2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource NeutroFondo}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource NeutroTexto}"/>
        <Setter Property="TextElement.FontSize" Value="12"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Estado}" Value="Recibida">
                <Setter Property="Background" Value="{StaticResource AvisoFondo}"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource AvisoTexto}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Estado}" Value="Validada">
                <Setter Property="Background" Value="{StaticResource InfoFondo}"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource InfoTexto}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Estado}" Value="Pagada">
                <Setter Property="Background" Value="{StaticResource OkFondo}"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource OkTexto}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Pastilla de resultado del importador (Binding Resultado) -->
    <Style x:Key="PastillaImportacion" TargetType="Border" BasedOn="{StaticResource PastillaEstado}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Resultado}" Value="procesada">
                <Setter Property="Background" Value="{StaticResource OkFondo}"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource OkTexto}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Resultado}" Value="duplicada">
                <Setter Property="Background" Value="{StaticResource NeutroFondo}"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource NeutroTexto}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Resultado}" Value="sin_factura">
                <Setter Property="Background" Value="{StaticResource AvisoFondo}"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource AvisoTexto}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Resultado}" Value="error">
                <Setter Property="Background" Value="{StaticResource ErrorFondo}"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource ErrorTexto}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Tarjeta de cifra del panel de inicio (botón: al pulsarla abre el listado filtrado) -->
    <Style x:Key="TarjetaCifra" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,12,12"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Marco" Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borde}"
                            BorderThickness="1" CornerRadius="{StaticResource Radio}" Padding="18,14">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource Rojo}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="EtiquetaCifra" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
    </Style>
    <Style x:Key="ValorCifra" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
    </Style>
    <Style x:Key="DetalleCifra" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Etiqueta-botón del resumen de revisión (Background/Foreground/BorderBrush se ponen desde código) -->
    <Style x:Key="Chip" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Padding" Value="10,3,10,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource NeutroFondo}"/>
        <Setter Property="Foreground" Value="{StaticResource NeutroTexto}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Marco" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource TextoSuave}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sección plegable del formulario (cabecera con flecha; se recuerda si está plegada) -->
    <Style x:Key="SeccionPlegable" TargetType="Expander">
        <Setter Property="IsExpanded" Value="True"/>
        <Setter Property="Margin" Value="0,12,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Top" Focusable="False" Cursor="Hand"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" BorderBrush="{StaticResource Borde}" BorderThickness="0,0,0,1" Padding="0,2,0,5">
                                        <DockPanel>
                                            <Path x:Name="Flecha" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                                  Data="M 0 4 L 4 0 L 8 4" Stroke="{StaticResource TextoSuave}" StrokeThickness="1.5"/>
                                            <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                              TextElement.FontSize="14" TextElement.FontWeight="SemiBold"
                                                              TextElement.Foreground="{StaticResource Texto}"/>
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="Flecha" Property="Data" Value="M 0 0 L 4 4 L 8 0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Contenido" Margin="0,2,0,0" Visibility="Collapsed"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Contenido" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================== Botones -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Superficie}"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeControl}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radio}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Fondo}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Separador}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource Rojo}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Rojo}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Rojo}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radio}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource RojoOscuro}"/>
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource RojoOscuro}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource Texto}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource ErrorTexto}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ErrorBorde}"/>
    </Style>
    <Style x:Key="BotonBarra" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style x:Key="BotonBarraPrimario" TargetType="Button" BasedOn="{StaticResource BotonPrimario}">
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <!-- Botón plano tipo enlace -->
    <Style x:Key="BotonEnlace" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Rojo}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="T" Background="Transparent"><ContentPresenter RecognizesAccessKey="True"/></TextBlock>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="TextDecorations" Value="Underline"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================== Campos -->
    <Style TargetType="TextBox">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource Superficie}"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeControl}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Rojo}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Marco" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radio}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Marco" Property="Background" Value="{StaticResource Fondo}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Marco" Property="Background" Value="{StaticResource Fondo}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource TextoTenue}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource Rojo}"/>
                        </Trigger>
                        <!-- Multilínea: barras de desplazamiento visibles y texto arriba -->
                        <Trigger Property="AcceptsReturn" Value="True">
                            <Setter TargetName="PART_ContentHost" Property="VerticalScrollBarVisibility" Value="Auto"/>
                            <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Stretch"/>
                            <Setter TargetName="PART_ContentHost" Property="Margin" Value="0,4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Importe" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource Superficie}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeControl}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Marco" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radio}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource TextoTenue}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource Rojo}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox (normal y editable) -->
    <ControlTemplate x:Key="ComboFlecha" TargetType="ToggleButton">
        <Border x:Name="Marco" Background="{StaticResource Superficie}" BorderBrush="{StaticResource BordeControl}"
                BorderThickness="1" CornerRadius="{StaticResource Radio}" SnapsToDevicePixels="True">
            <Path x:Name="Flecha" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                  Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource TextoSuave}" StrokeThickness="1.5"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource TextoTenue}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource Rojo}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Marco" Property="Background" Value="{StaticResource Fondo}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="ComboTextoEditable" TargetType="TextBox">
        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"
                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
    </ControlTemplate>
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Template="{StaticResource ComboFlecha}" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="8,0,26,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <TextBox x:Name="PART_EditableTextBox" Template="{StaticResource ComboTextoEditable}"
                                 Margin="7,0,26,0" VerticalAlignment="Center" Background="Transparent" Height="Auto"
                                 Focusable="True" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,2,0,0"
                                    Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borde}"
                                    BorderThickness="1" CornerRadius="{StaticResource Radio}" Padding="2">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Fondo" Padding="{TemplateBinding Padding}" CornerRadius="4" Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Fondo}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource RojoTinte}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Height" Value="30"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeControl}"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource Rojo}"/>
        <Setter Property="Background" Value="{StaticResource Separador}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="4"/>
    </Style>

    <!-- ===================================================== Tablas -->
    <Style x:Key="CabeceraTabla" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Fondo}"/>
        <Setter Property="Foreground" Value="{StaticResource TextoEtiqueta}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="8,7"/>
        <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <Path x:Name="Orden" DockPanel.Dock="Right" Margin="4,0,0,0" VerticalAlignment="Center"
                                      Fill="{StaticResource TextoSuave}" Visibility="Collapsed" Data="M 0 4 L 4 0 L 8 4 Z"/>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </DockPanel>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="6" Cursor="SizeWE" Opacity="0"/>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="Orden" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="Orden" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Orden" Property="Data" Value="M 0 0 L 4 4 L 8 0 Z"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Separador}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Celda" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="FilaTabla" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource Superficie}"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Fondo}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource RojoTinte}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Filas dadas de baja en gris -->
    <Style x:Key="FilaConBaja" TargetType="DataGridRow" BasedOn="{StaticResource FilaTabla}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Baja}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextoTenue}"/>
                <Setter Property="FontStyle" Value="Italic"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Tabla" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Separador}"/>
        <Setter Property="Background" Value="{StaticResource Superficie}"/>
        <Setter Property="RowBackground" Value="{StaticResource Superficie}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowHeight" Value="32"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource CabeceraTabla}"/>
        <Setter Property="CellStyle" Value="{StaticResource Celda}"/>
        <Setter Property="RowStyle" Value="{StaticResource FilaTabla}"/>
    </Style>

    <!-- ===================================================== Barra lateral -->
    <Style x:Key="ItemLateral" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource LateralTexto}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Fondo" Background="Transparent" CornerRadius="{StaticResource Radio}" Padding="12,8">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource LateralHover}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Rojo}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
